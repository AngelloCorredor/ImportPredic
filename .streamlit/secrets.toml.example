# Copia este archivo como .streamlit/secrets.toml (local) o pega su
# contenido en "Settings -> Secrets" de Streamlit Community Cloud.
# secrets.toml está en .gitignore: nunca se sube al repositorio.

# Key de https://openrouter.ai -> Keys
OPENROUTER_API_KEY = ""

# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# (vacía en local = se genera sola; en producción es obligatoria)
APP_SECRET_KEY = ""

# "development" en tu equipo, "production" en el servidor
APP_ENV = "development"

# Comentado = SQLite local (data/importpredic.db).
# En la nube descoméntalo con los datos de tu PostgreSQL (Supabase/Neon/Railway):
# DATABASE_URL = "postgresql+psycopg2://usuario:clave@host:5432/importpredic?sslmode=require"

ALLOW_REGISTRATION = true
AI_MAX_REQUESTS_PER_HOUR = 40
SESSION_TIMEOUT_MINUTES = 60
